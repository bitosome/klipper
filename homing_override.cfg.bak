[homing_override]
axes: xyz
gcode:
    {% set homing_zhop = printer["gcode_macro _USER_VARIABLES"].homing_zhop|float|abs %}
    {% set homing_travel_speed = printer["gcode_macro _USER_VARIABLES"].homing_travel_speed * 60 %}
    {% set homing_travel_accel = printer["gcode_macro _USER_VARIABLES"].homing_travel_accel %}
    {% set sensorless_current_factor = printer["gcode_macro _USER_VARIABLES"].sensorless_current_factor / 100 %}
    {% set x_homing_backoff, y_homing_backoff = printer["gcode_macro _USER_VARIABLES"].homing_backoff_distance_xy|map('float') %}
    {% set homing_first = printer["gcode_macro _USER_VARIABLES"].homing_first|string|upper %}
    
    {% set X, Y, Z = False, False, False %}
    {% if not 'X' in params and not 'Y' in params and not 'Z' in params %}
        {% set X, Y, Z = True, True, True %}
    {% else %}
        {% if 'X' in params %}{% set X = True %}{% endif %}
        {% if 'Y' in params %}{% set Y = True %}{% endif %}
        {% if 'Z' in params %}{% set Z = True %}{% endif %}
    {% endif %}

    CASE_LIGHT ENABLE=1
    STATUS_LEDS COLOR="homing"
    {% set saved_accel = printer.toolhead.max_accel %}
    SET_VELOCITY_LIMIT ACCEL={homing_travel_accel}

# ----- Z Safety Checks ----- #
    {% if Z %}
        {% if 'z' in printer.toolhead.homed_axes and printer.toolhead.position.z < homing_zhop %}
            G91
            G0 Z{homing_zhop} F{printer["gcode_macro _USER_VARIABLES"].z_drop_speed * 60}
            G90
        {% elif not 'xy' in printer.toolhead.homed_axes %}
            SET_KINEMATIC_POSITION X=0 Y=0 Z=0
            G0 Z{homing_zhop} F{printer["gcode_macro _USER_VARIABLES"].z_drop_speed * 60}
        {% endif %}
    {% endif %}

# ----- Sensorless X/Y Homing ----- #
    {% if X or Y %}
        {% set old_x_cur = printer.configfile.config["tmc2209 stepper_x"].run_current|float %}
        {% set old_y_cur = printer.configfile.config["tmc2209 stepper_y"].run_current|float %}
        
        {% if homing_first == "X" %}
            {% if X %}
                SET_TMC_CURRENT STEPPER=stepper_x CURRENT={old_x_cur * sensorless_current_factor}
                SET_TMC_CURRENT STEPPER=stepper_y CURRENT={old_y_cur * sensorless_current_factor}
                M400
                G28 X0
                G1 X{printer.configfile.config["stepper_x"]["position_endstop"]|float + x_homing_backoff} F{homing_travel_speed}
            {% endif %}
            {% if Y %}
                SET_TMC_CURRENT STEPPER=stepper_x CURRENT={old_x_cur * sensorless_current_factor}
                SET_TMC_CURRENT STEPPER=stepper_y CURRENT={old_y_cur * sensorless_current_factor}
                M400
                G28 Y0
                G1 Y{printer.configfile.config["stepper_y"]["position_endstop"]|float + y_homing_backoff} F{homing_travel_speed}
            {% endif %}
        {% else %}
            {# Repeat for Y-first order #}
            {% if Y %}
                SET_TMC_CURRENT STEPPER=stepper_x CURRENT={old_x_cur * sensorless_current_factor}
                SET_TMC_CURRENT STEPPER=stepper_y CURRENT={old_y_cur * sensorless_current_factor}
                M400
                G28 Y0
                G1 Y{printer.configfile.config["stepper_y"]["position_endstop"]|float + y_homing_backoff} F{homing_travel_speed}
            {% endif %}
            {% if X %}
                SET_TMC_CURRENT STEPPER=stepper_x CURRENT={old_x_cur * sensorless_current_factor}
                SET_TMC_CURRENT STEPPER=stepper_y CURRENT={old_y_cur * sensorless_current_factor}
                M400
                G28 X0
                G1 X{printer.configfile.config["stepper_x"]["position_endstop"]|float + x_homing_backoff} F{homing_travel_speed}
            {% endif %}
        {% endif %}
        
        {# Restore currents #}
        SET_TMC_CURRENT STEPPER=stepper_x CURRENT={old_x_cur}
        SET_TMC_CURRENT STEPPER=stepper_y CURRENT={old_y_cur}
        M400
    {% endif %}

# ----- Z Homing ----- #
    {% if Z %}
        {% if printer.configfile.config["bed_mesh"]["zero_reference_position"] %}
            {% set ZRPx, ZRPy = printer.configfile.config["bed_mesh"]["zero_reference_position"].split(',')|map('trim')|map('float') %}
            G0 X{ZRPx} Y{ZRPy} F{homing_travel_speed}
        {% else %}
            G0 X{(printer.toolhead.axis_maximum.x + printer.toolhead.axis_minimum.x)/2} Y{(printer.toolhead.axis_maximum.y + printer.toolhead.axis_minimum.y)/2} F{homing_travel_speed}
        {% endif %}
        G28 Z0
        G91
        G0 Z-{homing_zhop} F{printer["gcode_macro _USER_VARIABLES"].z_drop_speed * 60}
        G90
    {% endif %}

    SET_VELOCITY_LIMIT ACCEL={saved_accel}
    STATUS_LEDS COLOR="ready"